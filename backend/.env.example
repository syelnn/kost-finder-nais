# ==========================================================
# Kos Finder - Konfigurasi Backend
# Salin file ini menjadi .env lalu isi nilainya.
# ==========================================================

# Connection string PostgreSQL Supabase
# Supabase Dashboard > Connect > "Session pooler" (disarankan, IPv4) atau "Direct connection"
# Contoh session pooler:
# postgresql://postgres.abcdefghijklmnop:PASSWORD_DB@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD_DB@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Set "false" HANYA bila memakai PostgreSQL lokal tanpa SSL (Supabase wajib SSL)
DB_SSL=true

# Kunci rahasia JWT (ganti dengan string acak panjang)
JWT_SECRET=ganti-dengan-string-acak-yang-panjang-dan-rahasia
JWT_EXPIRES_IN=8h

# Origin frontend yang diizinkan CORS (pisahkan dengan koma bila lebih dari satu)
CLIENT_ORIGIN=http://localhost:5173

PORT=5000
TZ=Asia/Jakarta
